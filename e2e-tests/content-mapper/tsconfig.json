{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "contentMappers": [
    {
      "package": "@nitrogql/cli",
      "extensions": [".graphql"]
    }
  ]
}
